      "css": ".ds-brand{box-sizing:border-box;position:relative;isolation:isolate;display:inline-flex;align-items:center;gap:8px;direction:ltr;height:42px;min-height:42px;padding:0 4px;border:0;border-radius:8px;background:transparent;color:#272329;cursor:pointer}.ds-brand-mark,.ds-brand-wordmark{display:block;flex:none}.ds-brand::before{content:\"\";position:absolute;z-index:-1;inset:0;border-radius:8px;background:#F3E9ED;opacity:0;pointer-events:none;transition:opacity 100ms cubic-bezier(.333333,1,.666667,1)}.ds-brand:hover:not(:disabled)::before{opacity:1;transition-duration:130ms}.ds-brand:active:not(:disabled){background:#F8E3E9}.ds-brand:active:not(:disabled)::before{opacity:0}.ds-brand::after{content:\"\";position:absolute;inset:0;border:2px solid #A91F33;border-radius:8px;opacity:0;pointer-events:none}.ds-brand:focus-visible{outline:none}.ds-brand:focus-visible::after{opacity:1}.ds-brand:disabled{opacity:.55;cursor:default}@media(prefers-reduced-motion:reduce){.ds-brand::before{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "The Red Download Mark",
    "overview": "Vydrop pairs a rounded red download arrow and receiving tray with a compact fixed vector wordmark: a larger bespoke red V with an angled right terminal, followed by lighter Inter Regular outlines in theme Ink. Crimson actions and rose selections sit on shared light or charcoal working surfaces. The established bilingual Windows composition, embedded type and visible focus stay intact. These are extracted source rules for the approved rebrand; the HTML samples are illustrative WPF translations and do not substitute for native rendering or workflow verification.",
    "keyCharacteristics": [
      "One flat red mark and a custom vector wordmark across desktop and companion.",
      "Continuous Page ground with tonal control faces and quiet separators.",
      "English/Arabic task direction with stable physical header and pane anchors.",
      "Short, silent, finite feedback that respects Windows animation and high contrast preferences."
    ],
    "rules": [
      {
        "body": "BrandFill is identity paint; Action is a filled control; Accent is a readable detail. Preserve independent semantic status roles and system high-contrast substitutions.",
        "section": "colors",
        "name": "The Role Rule"
      },
      {
        "body": "Reuse BrandInitialGeometry for the larger bespoke red V with its angled right terminal, and BrandLettersGeometry for licensed Inter Regular ydrop outlines in theme Ink. The V is 28 source units tall versus the remaining letters' approximately 21.8-unit ascender height, with the baseline aligned. Keep the compact 90 × 30-DIP wordmark Viewbox (104.066 × 34.104 source canvas) physically LTR and uniformly scaled beside the canonical symbol.",
        "section": "typography",
        "name": "The Lettering Rule"
      },
      {
        "body": "Use Page, Surface, Field and thin borders for depth. Inspected native themes define no shared application shadow token.",
        "section": "elevation",
        "name": "Tonal Depth"
      },
      {
        "body": "The split threshold is computed from client width, MinWidth, chrome and the 320-DIP pane minimum. The 1000-DIP constant only guards automatic expansion; it is not a universal responsive breakpoint.",
        "section": "layout",
        "name": "Content Fit"
      },
      {
        "name": "Tonal Ramp Metadata",
        "body": "The eight-step OKLCH ramps are synthesized display metadata derived from each canonical hexadecimal token: constant hue and chroma, stepped lightness from 15% to 95%. They do not introduce application theme tokens or change the normative palette.",
        "section": "colors"
      },
      {
        "name": "The Stable Focus Rule",
        "body": "The brand action keeps its fixed 42-DIP height and four-DIP horizontal padding. Its two-DIP Accent focus ring is painted as an overlay inside fixed bounds; clicking, pressing or focusing cannot alter header height or move the following content.",
        "section": "components"
      }
    ],
    "dos": [
      "Do use semantic light/dark pairs and preserve Windows high contrast.",
      "Do keep labels, checkmarks and keyboard focus alongside color.",
      "Do preserve approved layout, type, control geometry and finite silent motion.",
      "Do reuse the canonical vector lockup and preserve its LTR direction.",
      "Do label synthetic evidence and retain raster provenance."
    ],
    "donts": [
      "Do not restore historical ViFree lettering or superseded brand palettes on current Vydrop surfaces.",
      "Do not recreate the wordmark as ordinary text.",
      "Do not fabricate media details, artwork or success.",
      "Do not add sound, looping decoration or motion that overrides Windows preferences.",
      "Do not rename persisted compatibility identifiers as part of a visible rebrand."
    ]
  }
}
