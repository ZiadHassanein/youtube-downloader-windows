      "kind": "button",
      "refersTo": "button-primary",
      "description": "Light-theme translation of the centered native 280 × 52-DIP primary action; state styling preserves its semantic role.",
      "html": "<button class=\"ds-primary\" type=\"button\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M10 1V13M5 8L10 13L15 8M2 14V19H18V14\"/></svg>Download</button>",
      "css": ".ds-primary{box-sizing:border-box;position:relative;isolation:isolate;display:inline-flex;align-items:center;justify-content:center;gap:10px;width:280px;min-height:52px;padding:8px 16px;border:1px solid #BA263A;border-radius:8px;background:#BA263A;color:#FFF;font:600 17px Inter,sans-serif;cursor:pointer}.ds-primary svg{fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}.ds-primary::before{content:\"\";position:absolute;z-index:-1;inset:0;border-radius:7px;background:#FFF;opacity:0;pointer-events:none;transition:opacity 100ms cubic-bezier(.333333,1,.666667,1)}.ds-primary:hover::before{opacity:.08;transition-duration:130ms}.ds-primary:active{border-color:#272329}.ds-primary:focus-visible{outline:2px solid #272329;outline-offset:-2px}.ds-primary:disabled{opacity:.5;cursor:default}.ds-primary:disabled::before{opacity:0}@media(prefers-reduced-motion:reduce){.ds-primary::before{transition:none}}"
    },
