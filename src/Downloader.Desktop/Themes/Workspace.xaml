<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="SectionLabel" TargetType="TextBlock">
  <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,9"/>
 </Style>
 <Style x:Key="FormatSegment" TargetType="RadioButton">
  <Setter Property="MinHeight" Value="46"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
  <Setter Property="Background" Value="{DynamicResource Field}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
  <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="RadioButton">
    <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsChecked" Value="False"/></MultiTrigger.Conditions>
      <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Accent}"/>
     </MultiTrigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderThickness" Value="2"/><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate>
  </Setter.Value></Setter>
  <Style.Triggers>
   <Trigger Property="IsChecked" Value="True">
    <Setter Property="Background" Value="{DynamicResource Selected}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    <Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/>
   </Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="AudioFormatSegment" TargetType="RadioButton" BasedOn="{StaticResource FormatSegment}">
  <Style.Triggers>
   <Trigger Property="IsChecked" Value="True">
    <Setter Property="Background" Value="{DynamicResource AudioSelected}"/><Setter Property="BorderBrush" Value="{DynamicResource AudioAccent}"/>
    <Setter Property="Foreground" Value="{DynamicResource AudioAccent}"/>
   </Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="SelectionMenuItem" TargetType="MenuItem">
  <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="MinHeight" Value="44"/>
  <Setter Property="Margin" Value="0,3"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
   <Border x:Name="Face" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="8" Padding="12,8">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
     <Path x:Name="Check" Data="{DynamicResource CheckIcon}" Style="{DynamicResource LineIcon}" Stroke="{DynamicResource Accent}" Width="14" Height="14" Visibility="Hidden"/>
     <ContentPresenter Grid.Column="1" ContentSource="Header" Margin="8,0" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Grid>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsHighlighted" Value="True">
     <Setter TargetName="Face" Property="Background" Value="{DynamicResource Hover}"/>
     <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Trigger>
    <Trigger Property="IsChecked" Value="True">
     <Setter TargetName="Face" Property="Background" Value="{DynamicResource Selected}"/>
     <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Accent}"/>
     <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
     <Setter Property="FontWeight" Value="SemiBold"/>
    </Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Ink}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
