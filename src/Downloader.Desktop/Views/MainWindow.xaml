<Window x:Class="YouTubeDownloader.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:YouTubeDownloader"
 Title="ViFree" Icon="pack://application:,,,/ViFree;component/Assets/app.ico"
 Width="1160" Height="800" MinWidth="820" MinHeight="500" WindowStartupLocation="CenterScreen"
 Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}" FontFamily="{StaticResource LatinFont}" FontSize="14"
 UseLayoutRounding="True" SnapsToDevicePixels="True" FlowDirection="LeftToRight">
 <Grid x:Name="Root">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border x:Name="HeaderContent" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="24,12">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Path Data="{StaticResource PlayMark}" Fill="{DynamicResource Action}" Width="34" Height="38" Stretch="Uniform" Margin="0,0,12,0" AutomationProperties.Name="ViFree logo"/>
     <TextBlock x:Name="BrandWordmark" Text="ViFree" FontFamily="{StaticResource LatinFont}" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" AutomationProperties.Name="ViFree"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="28,0,12,0" VerticalAlignment="Center" TextElement.FontFamily="{Binding ContentFont}">
     <Button Command="{Binding NewDownloadCommand}" Style="{StaticResource ToolbarButton}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Padding="10,6">
      <Border BorderBrush="{DynamicResource Accent}" BorderThickness="0,0,0,2" Padding="0,8"><TextBlock Text="{Binding NewDownloadLabel}"/></Border>
     </Button>
     <Button Content="{Binding RecentLabel}" Command="{Binding HistoryCommand}" Style="{StaticResource ToolbarButton}" Margin="8,0,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="{Binding LanguageAction}" Command="{Binding LanguageCommand}" FontFamily="{StaticResource ArabicFont}" MinWidth="76" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="{Binding LanguageAction}"/>
     <Button Command="{Binding ThemeCommand}" Width="42" Padding="10" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="{Binding ThemeAction}" ToolTip="{Binding ThemeAction}">
      <Path Data="{Binding ThemeIcon}" Stroke="{DynamicResource Accent}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="20" Height="20"/>
     </Button>
     <Button x:Name="SettingsButton" Command="{Binding SettingsCommand}" Width="42" Padding="10" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="{Binding SettingsLabel}" ToolTip="{Binding SettingsLabel}">
      <Path Data="{StaticResource SettingsIcon}" Style="{StaticResource LineIcon}"/>
     </Button>
    </StackPanel>
   </Grid>
  </Border>
  <ScrollViewer x:Name="Viewport" Grid.Row="1" Style="{StaticResource VerticalScrollFrame}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FlowDirection="{Binding ContentDirection}">
   <Grid x:Name="PageContent" FlowDirection="{Binding ContentDirection}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="55*"/><ColumnDefinition Width="45*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <local:DownloadFormView x:Name="DownloadForm" VerticalAlignment="Top"/>
    <Grid x:Name="ContextPane" Grid.Column="1">
     <local:MediaPreviewView x:Name="MediaPreview"/>
     <local:SettingsView x:Name="SettingsPane" Visibility="{Binding SettingsVisible,Converter={StaticResource BoolVisibility}}"/>
    </Grid>
   </Grid>
  </ScrollViewer>
  <Border x:Name="FooterContent" Grid.Row="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="24,8">
   <Grid FlowDirection="LeftToRight">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="By Ziad Hassanein" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
     <Button Content="GitHub" Command="{Binding SocialCommand}" CommandParameter="github" Style="{StaticResource QuietButton}" FontSize="12" Padding="7,4" MinHeight="28"/>
     <Button Content="LinkedIn" Command="{Binding SocialCommand}" CommandParameter="linkedin" Style="{StaticResource QuietButton}" FontSize="12" Padding="7,4" MinHeight="28"/>
     <Button Content="Email" Command="{Binding SocialCommand}" CommandParameter="email" Style="{StaticResource QuietButton}" FontSize="12" Padding="7,4" MinHeight="28"/>
    </StackPanel>
   </Grid>
  </Border>
  <Border x:Name="Notice" Visibility="{Binding MainNoticeVisible,Converter={StaticResource BoolVisibility}}" Background="{DynamicResource Surface}"
          BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,0"
          FlowDirection="LeftToRight" TextElement.FontFamily="{Binding ContentFont}" VerticalAlignment="Top">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding NoticeLeadingWidth}"/><ColumnDefinition Width="{Binding NoticeTrailingWidth}"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="{Binding NoticeTextColumn}">
     <TextBlock x:Name="NoticeHeading" TextAlignment="{Binding NoticeAlignment}" FlowDirection="LeftToRight" Text="{Binding NoticeHeading}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{Binding NoticeBrush}" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock TextAlignment="{Binding NoticeAlignment}" FlowDirection="LeftToRight" Text="{Binding NoticeDetail}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/>
     <ProgressBar x:Name="ToolRefreshProgressBar" Value="{Binding ToolRefreshProgress,Mode=OneWay}" IsIndeterminate="{Binding ToolRefreshIndeterminate}" Visibility="{Binding IsRefreshingTools,Converter={StaticResource BoolVisibility}}" Height="4" Margin="0,10,0,0" Foreground="{DynamicResource Accent}" Background="{DynamicResource Field}" FlowDirection="LeftToRight" AutomationProperties.Name="{Binding ToolRefreshLabel}"/>
     <Button x:Name="ToolRefreshCancel" Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" Visibility="{Binding IsRefreshingTools,Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
    </StackPanel>
    <Button x:Name="NoticeDismiss" Grid.Column="{Binding NoticeDismissColumn}" Command="{Binding DismissNoticeCommand}" Padding="8" MinHeight="30" VerticalAlignment="Top" Style="{StaticResource QuietButton}" AutomationProperties.Name="{Binding DismissLabel}">
     <Path Data="M0,0 L10,10 M10,0 L0,10" Style="{StaticResource LineIcon}" Width="11" Height="11"/>
    </Button>
   </Grid>
  </Border>
 </Grid>
</Window>
