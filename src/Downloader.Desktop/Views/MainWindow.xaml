<Window x:Class="YouTubeDownloader.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ViFree" Icon="pack://application:,,,/ViFree;component/Assets/app.ico" Width="920" MinWidth="820" MinHeight="400" WindowStartupLocation="CenterScreen" Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}" FontFamily="{StaticResource LatinFont}" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True" FlowDirection="LeftToRight">
  <Grid x:Name="Root" MaxWidth="1040" Margin="24,16,24,16">
    <ScrollViewer x:Name="Viewport" Style="{StaticResource VerticalScrollFrame}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FlowDirection="{Binding ContentDirection}">
      <Grid x:Name="PageContent" FlowDirection="LeftToRight">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
        <Grid Margin="0,0,0,18" FlowDirection="LeftToRight">
          <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Image Source="pack://application:,,,/ViFree;component/Assets/header-logo.png" Width="42" Height="42" HorizontalAlignment="Left" AutomationProperties.Name="ViFree logo"/>
          <TextBlock x:Name="BrandWordmark" Grid.Column="1" FontSize="24" VerticalAlignment="Center" AutomationProperties.Name="ViFree"><Run Text="Vi" FontWeight="Bold" Foreground="{DynamicResource Accent}"/><Run Text="Free" FontWeight="Medium" Foreground="{DynamicResource Ink}"/></TextBlock>
          <Button Grid.Column="2" Content="{Binding LanguageAction}" Command="{Binding LanguageCommand}" FontFamily="{StaticResource ArabicFont}" MinWidth="92" Margin="8,0" VerticalAlignment="Center" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="{Binding LanguageAction}"/>
          <Button Grid.Column="3" Command="{Binding ThemeCommand}" Width="42" MinHeight="42" Padding="10" VerticalAlignment="Center" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="{Binding ThemeAction}" ToolTip="{Binding ThemeAction}"><Path Data="{Binding ThemeIcon}" Stroke="{DynamicResource Accent}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="19" Height="19"/></Button>
        </Grid>
        <Border Height="1" Background="{DynamicResource Divider}" Margin="0,0,0,24"/>
        </StackPanel>
        <StackPanel Grid.Row="1" FlowDirection="{Binding ContentDirection}" TextElement.FontFamily="{Binding ContentFont}">
          <TextBlock Text="{Binding LinkLabel}" FontWeight="SemiBold" Margin="0,0,0,9"/>
          <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
            <Grid><TextBox x:Name="LinkInput" Text="{Binding Url,UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource LatinFont}" FontSize="15" FlowDirection="LeftToRight" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{Binding LinkLabel}"/>
              <TextBlock x:Name="LinkPlaceholder" Text="{Binding LinkPlaceholder}" Foreground="{DynamicResource Muted}" FontSize="15" Margin="15,0" VerticalAlignment="Center" IsHitTestVisible="False" FlowDirection="{Binding ContentDirection}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Url}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </Grid>
            <Button Grid.Column="2" Content="{Binding PasteLabel}" Command="{Binding PasteCommand}"/>
          </Grid>
          <StackPanel Visibility="{Binding HasPlaylist,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,22"><UniformGrid Columns="2"><RadioButton Content="{Binding SingleLabel}" IsChecked="{Binding SingleVideo}" IsEnabled="{Binding CanSelectSingle}" Margin="0,0,6,0"/><RadioButton Content="{Binding PlaylistLabel}" IsChecked="{Binding WholePlaylist}" IsEnabled="{Binding IsIdle}" Margin="6,0,0,0"/></UniformGrid></StackPanel>
          <TextBlock Text="{Binding FormatLabel}" FontWeight="SemiBold" Margin="0,0,0,9"/>
          <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <RadioButton IsChecked="{Binding Video}" IsEnabled="{Binding IsIdle}" GroupName="Format" AutomationProperties.Name="{Binding VideoLabel}"><StackPanel Orientation="Horizontal"><Path Data="M 1 2 L 13 2 L 13 12 L 1 12 Z M 13 5 L 18 2 L 18 12 L 13 9" Stroke="{DynamicResource Ink}" StrokeThickness="1.3" StrokeLineJoin="Round" Width="17" Height="16" Stretch="Uniform" Margin="0,0,9,0"/><TextBlock Text="{Binding VideoLabel}" VerticalAlignment="Center"/></StackPanel></RadioButton>
            <RadioButton Grid.Column="2" Tag="Audio" IsChecked="{Binding Audio}" IsEnabled="{Binding IsIdle}" GroupName="Format" AutomationProperties.Name="{Binding AudioLabel}"><StackPanel Orientation="Horizontal"><Path Data="M 1 5 L 1 11 M 5 2 L 5 14 M 9 0 L 9 16 M 13 3 L 13 13 M 17 6 L 17 10" Stroke="{DynamicResource Ink}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="17" Height="16" Stretch="Uniform" Margin="0,0,9,0"/><TextBlock Text="{Binding AudioLabel}" VerticalAlignment="Center"/></StackPanel></RadioButton>
            <ComboBox x:Name="QualityInput" Grid.Column="4" ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality}" DisplayMemberPath="Label" IsEnabled="{Binding CanChooseQuality}" AutomationProperties.Name="{Binding QualityLabel}"/>
          </Grid>
          <TextBlock Text="{Binding FolderLabel}" FontWeight="SemiBold" Margin="0,0,0,9"/>
          <Grid x:Name="FolderAnchor" Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="100"/><ColumnDefinition Width="12"/><ColumnDefinition Width="132"/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding Folder,UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" FontFamily="{StaticResource LatinFont}" FontSize="14" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{Binding FolderLabel}"/>
            <Button Grid.Column="2" Content="{Binding BrowseLabel}" Command="{Binding BrowseCommand}"/>
            <Button Grid.Column="4" Content="{Binding OpenFolderLabel}" Command="{Binding OpenFolderCommand}"/>
          </Grid>
          <StackPanel x:Name="FolderNoticeHost" FlowDirection="LeftToRight"/>
          <Border Height="1" Background="{DynamicResource Divider}" Margin="0,24,0,24"/>
          <WrapPanel HorizontalAlignment="Center" FlowDirection="{Binding ContentDirection}">
            <Button Command="{Binding DownloadCommand}" Style="{StaticResource PrimaryButton}" Width="306" AutomationProperties.Name="{Binding DownloadLabel}"><StackPanel Orientation="Horizontal"><Path Data="M 8 0 L 8 12 M 3 7 L 8 12 L 13 7 M 1 13 L 1 17 L 15 17 L 15 13" Stroke="{DynamicResource OnAccent}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="17" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="{Binding DownloadLabel}" Foreground="{DynamicResource OnAccent}" VerticalAlignment="Center"/></StackPanel></Button>
            <Button Command="{Binding HistoryCommand}" MinHeight="52" MinWidth="188" Margin="12,0,0,0" AutomationProperties.Name="{Binding HistoryLabel}"><StackPanel Orientation="Horizontal"><Path Data="M 4 3 A 7 7 0 1 1 1 8 M 1 1 L 1 5 L 5 5 M 8 4 L 8 9 L 11 11" Stroke="{DynamicResource Muted}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="17" Stretch="Uniform" Margin="0,0,9,0"/><TextBlock Text="{Binding HistoryLabel}" VerticalAlignment="Center"/></StackPanel></Button>
          </WrapPanel>
          <StackPanel Visibility="{Binding HasStatus,Converter={StaticResource BoolVisibility}}" Margin="0,22,0,0"><TextBlock x:Name="StatusHeading" Text="{Binding StatusHeading}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding StatusDetail}" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/><ProgressBar Value="{Binding Progress,Mode=OneWay}" IsIndeterminate="{Binding Indeterminate}" Height="4" Foreground="{DynamicResource Accent}" Background="{DynamicResource Field}" Margin="0,14,0,0" Visibility="{Binding ShowProgress,Converter={StaticResource BoolVisibility}}"/><WrapPanel Margin="0,14,0,0"><Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}"/><Button Content="{Binding OpenFileLabel}" Command="{Binding OpenFileCommand}" Visibility="{Binding HasFile,Converter={StaticResource BoolVisibility}}"/><Button Content="{Binding RevealLabel}" Command="{Binding RevealCommand}" Visibility="{Binding HasFile,Converter={StaticResource BoolVisibility}}" Margin="12,0,0,0"/></WrapPanel></StackPanel>
        </StackPanel>
        <StackPanel x:Name="FooterContent" Grid.Row="3">
        <Border Height="1" Background="{DynamicResource Divider}" Margin="0,24,0,10"/>
        <StackPanel x:Name="UpdateNoticeHost" FlowDirection="LeftToRight"/>
        <Grid FlowDirection="{Binding ContentDirection}" TextElement.FontFamily="{Binding ContentFont}" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Button x:Name="UpdateAnchor" Command="{Binding UpdateCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" AutomationProperties.Name="{Binding UpdateLabel}" FontSize="13"><StackPanel Orientation="Horizontal"><Path Data="M 15 4 A 7 7 0 1 0 17 11 M 15 0 L 15 5 L 10 5" Stroke="{DynamicResource Accent}" StrokeThickness="1.4" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock Text="{Binding UpdateLabel}" Foreground="{DynamicResource Accent}"/></StackPanel></Button><TextBlock Grid.Column="1" Text="{Binding VersionLabel}" FontFamily="{StaticResource LatinFont}" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" FlowDirection="LeftToRight"/>
        </Grid>
        <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="By Ziad Hassanein" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><Button Content="{Binding ImportLabel}" Command="{Binding ImportCommand}" FontFamily="{Binding ContentFont}" Style="{StaticResource QuietButton}" FontSize="12" Margin="10,0,0,0" MinHeight="32" Padding="7,4"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="GitHub" Command="{Binding SocialCommand}" CommandParameter="github" Style="{StaticResource QuietButton}" FontSize="12" Padding="7,4" MinHeight="32"/><Button Content="LinkedIn" Command="{Binding SocialCommand}" CommandParameter="linkedin" Style="{StaticResource QuietButton}" FontSize="12" Padding="7,4" MinHeight="32"/><Button Content="Email" Command="{Binding SocialCommand}" CommandParameter="email" Style="{StaticResource QuietButton}" FontSize="12" Padding="7,4" MinHeight="32"/></StackPanel></Grid>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <Border x:Name="Notice" Visibility="{Binding NoticeVisible,Converter={StaticResource BoolVisibility}}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,0" FlowDirection="LeftToRight" TextElement.FontFamily="{Binding ContentFont}" VerticalAlignment="Top"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="{Binding NoticeLeadingWidth}"/><ColumnDefinition Width="{Binding NoticeTrailingWidth}"/></Grid.ColumnDefinitions><StackPanel Grid.Column="{Binding NoticeTextColumn}"><TextBlock x:Name="NoticeHeading" TextAlignment="{Binding NoticeAlignment}" FlowDirection="LeftToRight" Text="{Binding NoticeHeading}" FontWeight="SemiBold" Foreground="{Binding NoticeBrush}" AutomationProperties.LiveSetting="Polite"/><TextBlock TextAlignment="{Binding NoticeAlignment}" FlowDirection="LeftToRight" Text="{Binding NoticeDetail}" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel><Button x:Name="NoticeDismiss" Grid.Column="{Binding NoticeDismissColumn}" Command="{Binding DismissNoticeCommand}" Padding="8" MinHeight="30" VerticalAlignment="Top" Style="{StaticResource QuietButton}" AutomationProperties.Name="{Binding DismissLabel}"><Path Data="M 0 0 L 10 10 M 10 0 L 0 10" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" Width="11" Height="11"/></Button></Grid></Border>
  </Grid>
</Window>
