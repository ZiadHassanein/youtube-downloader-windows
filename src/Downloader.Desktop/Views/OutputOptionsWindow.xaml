<Window x:Class="YouTubeDownloader.OutputOptionsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{Binding OptionsLabel}" Width="540" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AutomationProperties.IsDialog="True"
 Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}" FontFamily="{Binding ContentFont}" FontSize="14"
 FlowDirection="{Binding ContentDirection}" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Grid x:Name="OptionsContent" Margin="28,24" KeyboardNavigation.TabNavigation="Cycle">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{Binding OptionsLabel}" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,24"/>
  <ScrollViewer x:Name="OptionsViewport" Grid.Row="1" Style="{StaticResource InsetScrollFrame}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <StackPanel IsEnabled="{Binding IsIdle}">
     <TextBlock Text="{Binding CaptionsLabel}" Style="{StaticResource SectionLabel}"/>
     <ComboBox x:Name="CaptionInput" ItemsSource="{Binding CaptionChoices}" SelectedItem="{Binding SelectedCaption}" AutomationProperties.Name="{Binding CaptionsLabel}"/>
     <Button x:Name="GetLanguages" Content="{Binding CaptionLanguagesLabel}" Command="{Binding CaptionLanguagesCommand}" Style="{StaticResource QuietButton}" Visibility="{Binding HasPlaylist,Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
     <TextBlock Text="{Binding CaptionFormatLabel}" Style="{StaticResource SectionLabel}" Margin="0,22,0,9"/>
     <Grid x:Name="CaptionFormatChoices" Margin="2,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <RadioButton x:Name="SrtOption" Content="SRT" IsChecked="{Binding SrtCaptions}" GroupName="Captions"/>
      <RadioButton x:Name="VttOption" Grid.Column="2" Content="VTT" IsChecked="{Binding VttCaptions}" GroupName="Captions"/>
     </Grid>
    </StackPanel>
    <ProgressBar IsIndeterminate="True" Height="4" Foreground="{DynamicResource Accent}" Background="{DynamicResource Border}" Margin="0,16,0,0" Visibility="{Binding CaptionLanguagesCommand.IsRunning,Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{Binding CaptionLanguagesLabel}"/>
    <Border x:Name="OptionsNotice" Background="{DynamicResource Surface}" CornerRadius="8" Padding="14" Margin="0,16,0,0" Visibility="{Binding OptionsNoticeVisible,Converter={StaticResource BoolVisibility}}">
     <StackPanel>
      <TextBlock x:Name="OptionsNoticeHeading" Text="{Binding NoticeHeading}" Foreground="{Binding NoticeBrush}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock Text="{Binding NoticeDetail}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
     </StackPanel>
    </Border>
    <TextBlock Text="{Binding OutputHint}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,22,0,0"/>
   </StackPanel>
  </ScrollViewer>
  <Button x:Name="DoneButton" Grid.Row="2" Content="{Binding DoneLabel}" Click="DoneClicked" IsDefault="True" IsCancel="True" Style="{StaticResource PrimaryButton}" MinWidth="112" HorizontalAlignment="Right" Margin="0,24,0,0"/>
 </Grid>
</Window>
