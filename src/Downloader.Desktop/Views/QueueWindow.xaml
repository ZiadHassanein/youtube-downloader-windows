<Window x:Class="YouTubeDownloader.QueueWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{Binding QueueHeading}" Width="700" Height="460" MinWidth="580" MinHeight="360"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AutomationProperties.IsDialog="True"
 Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}" FontFamily="{Binding ContentFont}" FontSize="13"
 FlowDirection="LeftToRight" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <Style x:Key="QueueButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="12,5"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="QueueQuietButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
   <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="8,4"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="QueuePrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
   <Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="14,6"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
 </Window.Resources>
 <Grid x:Name="QueueContent" Margin="24,20" FlowDirection="{Binding ContentDirection}"
       TextBlock.LineHeight="20" TextBlock.LineStackingStrategy="BlockLineHeight" KeyboardNavigation.TabNavigation="Cycle">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{Binding QueueHeading}" FontSize="21" LineHeight="28" FontWeight="SemiBold" Margin="0,0,0,16"/>
  <ScrollViewer x:Name="QueueViewport" Grid.Row="1" Style="{StaticResource InsetScrollFrame}"
                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <TextBlock Text="{Binding QueueInputLabel}" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <ItemsControl x:Name="QueueInputFields" ItemsSource="{Binding QueueLinkInputs}">
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <StackPanel Margin="0,0,0,10">
        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,4"/>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBox x:Name="QueueLinkField" Text="{Binding Url,UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource LatinFont}"
                  FlowDirection="LeftToRight" TextWrapping="NoWrap" AcceptsReturn="False" DataObject.Pasting="LinkPasting"
                  AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Error}">
          <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
           <Setter Property="Height" Value="36"/><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="10,4"/>
           <Style.Triggers>
           <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Error}"/></DataTrigger>
          </Style.Triggers></Style></TextBox.Style>
         </TextBox>
         <Button Grid.Column="2" Content="{Binding DataContext.PasteLabel,RelativeSource={RelativeSource AncestorType=Window}}"
                 Command="{Binding DataContext.PasteQueueLinkCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Click="LinkActionClicked" Style="{StaticResource QueueButton}" MinWidth="60"/>
         <Button Grid.Column="4" Command="{Binding DataContext.RemoveLinkFieldCommand,RelativeSource={RelativeSource AncestorType=Window}}"
                 CommandParameter="{Binding}" Click="LinkActionClicked" Style="{StaticResource QueueButton}" Width="36" Padding="0"
                 ToolTip="{Binding DataContext.RemoveLinkLabel,RelativeSource={RelativeSource AncestorType=Window}}"
                 AutomationProperties.Name="{Binding DataContext.RemoveLinkLabel,RelativeSource={RelativeSource AncestorType=Window}}">
          <Path Data="{StaticResource CloseIcon}" Style="{StaticResource LineIcon}" Width="14" Height="14"/>
         </Button>
        </Grid>
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Error}" FontSize="12" Margin="0,6,0,0"
                   Visibility="{Binding HasError,Converter={StaticResource BoolVisibility}}" AutomationProperties.LiveSetting="Polite"/>
       </StackPanel>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button x:Name="AddLinkFieldButton" Command="{Binding AddLinkFieldCommand}" Click="LinkActionClicked" Style="{StaticResource QueueQuietButton}" HorizontalAlignment="Left" Padding="0,4" Margin="0,0,0,8">
     <StackPanel Orientation="Horizontal"><Path Data="{StaticResource PlusIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Accent}" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="{Binding AddAnotherLinkLabel}"/></StackPanel>
    </Button>
    <Grid Margin="0,0,0,16">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding QueueSettingsHint}" Foreground="{DynamicResource Muted}" FontSize="12" LineHeight="18" VerticalAlignment="Center"/>
     <Button x:Name="AddQueueLinksButton" Grid.Column="2" Command="{Binding AddLinksCommand}" Click="SubmitLinksClicked" Style="{StaticResource QueueButton}" MinWidth="124" AutomationProperties.Name="{Binding AddQueueLabel}">
      <StackPanel Orientation="Horizontal">
       <Path Data="{StaticResource PlusIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Accent}" Width="16" Height="16" Margin="0,0,8,0"/>
       <TextBlock Text="{Binding AddQueueLabel}" TextWrapping="NoWrap"/>
      </StackPanel>
     </Button>
    </Grid>
    <Border x:Name="QueueNotice" Background="{DynamicResource Surface}" CornerRadius="8" Padding="10" Margin="0,0,0,12">
     <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding QueueMessage}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <TextBlock Text="{Binding QueueMessage}" Foreground="{DynamicResource Ink}" AutomationProperties.LiveSetting="Polite"/>
    </Border>
    <StackPanel x:Name="QueuedDownloadsSection" Visibility="{Binding HasQueue,Converter={StaticResource BoolVisibility}}">
    <TextBlock Text="{Binding QueueLabel}" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
      <ItemsControl x:Name="QueueItemsHost" ItemsSource="{Binding QueueItems}">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,10">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <StackPanel>
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Title}">
             <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource LatinFont}"/><Style.Triggers><DataTrigger Binding="{Binding HasArabicTitle}" Value="True"><Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Url}" FontFamily="{StaticResource LatinFont}" FlowDirection="LeftToRight" TextAlignment="Left"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" ToolTip="{Binding Url}"/>
            <TextBlock Text="{Binding Status}" FontSize="12" Margin="0,6,0,0">
             <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Style.Triggers>
              <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger>
              <DataTrigger Binding="{Binding Entry.State}" Value="Completed"><Setter Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger>
              <DataTrigger Binding="{Binding Entry.State}" Value="Failed"><Setter Property="Foreground" Value="{DynamicResource Error}"/></DataTrigger>
             </Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <ProgressBar Value="{Binding Percent,Mode=OneWay}" IsIndeterminate="{Binding IsPreparing}" Maximum="100" Height="4"
                         Foreground="{DynamicResource Accent}" Background="{DynamicResource Surface}" Margin="0,8,0,0"
                         Visibility="{Binding IsActive,Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{Binding Status}"/>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Error}" FontSize="12" Margin="0,6,0,0" Visibility="{Binding HasError,Converter={StaticResource BoolVisibility}}"/>
           </StackPanel>
           <StackPanel Grid.Column="2" VerticalAlignment="Top">
            <Button Content="{Binding DataContext.RetryLabel,RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.RetryQueueCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" Visibility="{Binding CanRetry,Converter={StaticResource BoolVisibility}}" Style="{StaticResource QueueQuietButton}"/>
            <Button Content="{Binding DataContext.RemoveLabel,RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.RemoveQueueCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" IsEnabled="{Binding CanRemove}" Style="{StaticResource QueueQuietButton}"/>
           </StackPanel>
          </Grid>
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
  <Border x:Name="QueueFooter" Grid.Row="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,16,0,0">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="QueueCloseButton" Content="{Binding CloseLabel}" Click="CloseClicked" IsCancel="True" Style="{StaticResource QueueButton}" MinWidth="76"/>
    <Button x:Name="QueueCancelButton" Grid.Column="2" Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" Style="{StaticResource QueueButton}" Margin="0,0,10,0" Visibility="{Binding QueueRunning,Converter={StaticResource BoolVisibility}}"/>
    <Button x:Name="QueueStartButton" Grid.Column="3" Content="{Binding StartQueueLabel}" Command="{Binding QueueDownloadCommand}" Click="SubmitLinksClicked" Style="{StaticResource QueuePrimaryButton}" MinWidth="136"/>
   </Grid>
  </Border>
 </Grid>
</Window>
