<Window x:Class="YouTubeDownloader.QueueWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding QueueHeading}" Width="760" Height="620" MinWidth="580" MinHeight="400" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}" FontFamily="{Binding ContentFont}" FontSize="14" FlowDirection="{Binding ContentDirection}" UseLayoutRounding="True">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="{Binding QueueHeading}" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding QueueHint}" Foreground="{DynamicResource Muted}" Margin="0,8,0,12"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox Text="{Binding QueueInput,UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource LatinFont}" AcceptsReturn="True" Height="94" VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" AutomationProperties.Name="{Binding QueueHint}"/>
      <Button Grid.Column="2" Content="{Binding AddQueueLabel}" Command="{Binding AddLinksCommand}" VerticalAlignment="Bottom"/>
    </Grid>
    <Grid Grid.Row="2">
      <TextBlock Text="{Binding QueueHint}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasQueue}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <ScrollViewer x:Name="QueueViewport" Style="{StaticResource VerticalScrollFrame}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding QueueItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,10">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource LatinFont}"/><Style.Triggers><DataTrigger Binding="{Binding HasArabicTitle}" Value="True"><Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Url}" FontFamily="{StaticResource LatinFont}" FlowDirection="LeftToRight" TextAlignment="Left" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,4,12,0"/>
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Accent}" FontSize="12" Margin="0,5,0,0"/>
                    <ProgressBar Value="{Binding Percent,Mode=OneWay}" Maximum="100" Height="3" Foreground="{DynamicResource Accent}" Background="{DynamicResource Field}" Margin="0,5,16,0"/>
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Error}" FontSize="12" Margin="0,5,12,0" Visibility="{Binding HasError,Converter={StaticResource BoolVisibility}}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="{Binding DataContext.RetryLabel,RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.RetryQueueCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" Visibility="{Binding CanRetry,Converter={StaticResource BoolVisibility}}" Style="{StaticResource QuietButton}"/>
                    <Button Content="{Binding DataContext.RemoveLabel,RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.RemoveQueueCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" IsEnabled="{Binding CanRemove}" Style="{StaticResource QuietButton}"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
    <TextBlock Grid.Row="3" Text="{Binding QueueMessage}" Foreground="{DynamicResource Muted}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
    <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="{Binding StartQueueLabel}" Command="{Binding QueueStartCommand}" Style="{StaticResource PrimaryButton}" MinWidth="150"/>
      <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" Margin="12,0,0,0"/>
      <Button Content="{Binding CloseLabel}" Click="CloseClicked" IsCancel="True" Margin="12,0,0,0"/>
    </WrapPanel>
  </Grid>
</Window>
