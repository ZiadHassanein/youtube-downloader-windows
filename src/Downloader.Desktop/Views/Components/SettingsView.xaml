<UserControl x:Class="YouTubeDownloader.SettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FlowDirection="{Binding ContentDirection}" FontFamily="{Binding ContentFont}">
 <UserControl.Resources>
  <ToolTip x:Key="DownloaderHelp" x:Shared="False" DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}"
           Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Border}" Padding="12" HasDropShadow="False"
           FontSize="14" FlowDirection="{Binding ContentDirection}" FontFamily="{Binding ContentFont}">
   <TextBlock Text="{Binding ToolRefreshHint}" TextWrapping="Wrap" MaxWidth="300"/>
  </ToolTip>
 </UserControl.Resources>
 <Border Background="{DynamicResource Surface}" Padding="28,26" FlowDirection="{Binding ContentDirection}">
  <StackPanel>
   <Grid Margin="0,0,0,24">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding SettingsLabel}" FontSize="23" LineHeight="32" FontWeight="SemiBold"/>
    <Button Grid.Column="1" Command="{Binding SettingsCommand}" Style="{StaticResource ToolbarButton}" Padding="8" MinHeight="32" AutomationProperties.Name="{Binding CloseLabel}">
     <Path Data="M1,1 L13,13 M13,1 L1,13" Style="{StaticResource LineIcon}" Width="14" Height="14"/>
    </Button>
   </Grid>
   <TextBlock Text="{Binding BrowserLabel}" Style="{StaticResource SectionLabel}"/>
   <TextBlock Text="{Binding BrowserSettingsHint}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,12"/>
   <Button Content="{Binding BrowserLabel}" Command="{Binding BrowserCommand}" HorizontalAlignment="Left"/>
   <Border Height="1" Background="{DynamicResource Divider}" Margin="0,24"/>
   <TextBlock Text="{Binding UpdateSectionLabel}" Style="{StaticResource SectionLabel}"/>
   <TextBlock Text="{Binding VersionLabel}" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource LatinFont}" FlowDirection="LeftToRight" Margin="0,0,0,12"/>
   <Button x:Name="UpdateAnchor" Content="{Binding UpdateLabel}" Command="{Binding UpdateCommand}" HorizontalAlignment="Left"/>
   <StackPanel x:Name="UpdateNoticeHost" FlowDirection="LeftToRight"/>
   <Border Height="1" Background="{DynamicResource Divider}" Margin="0,24"/>
   <TextBlock Text="{Binding DownloaderSectionLabel}" Style="{StaticResource SectionLabel}"/>
   <TextBlock Text="{Binding ToolRefreshHint}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,12"/>
   <Button x:Name="ToolRefreshAnchor" Content="{Binding ToolRefreshLabel}" Command="{Binding ToolRefreshCommand}" HorizontalAlignment="Left"
           AutomationProperties.HelpText="{Binding ToolRefreshHint}" ToolTipService.ShowOnDisabled="True" ToolTip="{StaticResource DownloaderHelp}"/>
   <StackPanel x:Name="ToolNoticeHost" FlowDirection="LeftToRight"/>
  </StackPanel>
 </Border>
</UserControl>
