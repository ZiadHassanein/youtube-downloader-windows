<UserControl x:Class="YouTubeDownloader.QueueFeedbackView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="18" Height="20" FlowDirection="LeftToRight" IsHitTestVisible="False" Focusable="False">
 <Grid>
  <Path x:Name="PlusMark" Data="{StaticResource PlusIcon}" Style="{StaticResource LineIcon}" Width="18" Height="18" Stroke="{DynamicResource Accent}"/>
  <Path x:Name="AddedMark" Data="{StaticResource CheckIcon}" Style="{StaticResource LineIcon}" Width="18" Height="18" Stroke="{DynamicResource Accent}" Opacity="0"/>
 </Grid>
</UserControl>
