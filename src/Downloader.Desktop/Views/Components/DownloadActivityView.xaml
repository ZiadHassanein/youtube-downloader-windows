<UserControl x:Class="YouTubeDownloader.DownloadActivityView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FlowDirection="{Binding ContentDirection}" FontFamily="{Binding ContentFont}">
 <StackPanel FlowDirection="{Binding ContentDirection}">
  <TextBlock x:Name="StatusHeading" Text="{Binding PreviewStatus}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" FontSize="15" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock Text="{Binding StatusDetail}" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" Visibility="{Binding HasStatus,Converter={StaticResource BoolVisibility}}" TextWrapping="Wrap"/>
  <ProgressBar x:Name="JobProgress" Value="{Binding Progress,Mode=OneWay}" IsIndeterminate="{Binding Indeterminate}" Foreground="{DynamicResource Accent}" Background="{DynamicResource Border}" Height="4" Margin="0,14,0,0" Visibility="{Binding ShowProgress,Converter={StaticResource BoolVisibility}}"/>
  <WrapPanel Margin="0,12,0,0" Visibility="{Binding HasStatus,Converter={StaticResource BoolVisibility}}">
   <Button x:Name="CancelDownload" Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}" Margin="0,0,8,8"/>
   <Button x:Name="OpenFile" Content="{Binding OpenFileLabel}" Command="{Binding OpenFileCommand}" Visibility="{Binding HasFile,Converter={StaticResource BoolVisibility}}" Margin="0,0,8,8"/>
   <Button x:Name="RevealFile" Content="{Binding RevealLabel}" Command="{Binding RevealCommand}" Visibility="{Binding HasFile,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8"/>
  </WrapPanel>
 </StackPanel>
</UserControl>
