<UserControl x:Class="YouTubeDownloader.DownloadFormView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FlowDirection="{Binding ContentDirection}" FontFamily="{Binding ContentFont}">
 <StackPanel Margin="30,26,30,28" FlowDirection="{Binding ContentDirection}">
  <TextBlock x:Name="NewDownloadHeading" Text="{Binding NewDownloadLabel}" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,22"/>
  <TextBlock Text="{Binding LinkLabel}" Style="{StaticResource SectionLabel}"/>
  <Grid Margin="0,0,0,24">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid>
    <TextBox x:Name="LinkInput" Text="{Binding Url,UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource LatinFont}" FontSize="14"
             FlowDirection="LeftToRight" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{Binding LinkLabel}"/>
    <TextBlock x:Name="LinkPlaceholder" Text="{Binding LinkPlaceholder}" Foreground="{DynamicResource Muted}" FontSize="14" Margin="14,0"
               VerticalAlignment="Center" IsHitTestVisible="False" FlowDirection="{Binding ContentDirection}">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
      <DataTrigger Binding="{Binding Url}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
     </Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </Grid>
   <Button x:Name="PasteButton" Grid.Column="2" Content="{Binding PasteLabel}" Command="{Binding PasteCommand}" MinWidth="82"/>
  </Grid>
  <StackPanel Visibility="{Binding HasPlaylist,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,20">
   <UniformGrid Columns="2">
    <RadioButton Content="{Binding SingleLabel}" IsChecked="{Binding SingleVideo}" IsEnabled="{Binding CanSelectSingle}" Margin="0,0,5,0"/>
    <RadioButton Content="{Binding PlaylistLabel}" IsChecked="{Binding WholePlaylist}" IsEnabled="{Binding IsIdle}" Margin="5,0,0,0"/>
   </UniformGrid>
   <Button Content="{Binding PlaylistSelectionLabel}" Command="{Binding PlaylistSelectionCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
  </StackPanel>
  <TextBlock Text="{Binding FormatLabel}" Style="{StaticResource SectionLabel}"/>
  <UniformGrid Columns="2" Margin="0,0,0,20">
   <RadioButton IsChecked="{Binding Video}" IsEnabled="{Binding IsIdle}" GroupName="MediaKind" Style="{StaticResource FormatSegment}" Margin="0,0,5,0" AutomationProperties.Name="{Binding VideoKindLabel}">
    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource VideoIcon}" Style="{StaticResource LineIcon}" Margin="0,0,8,0"/><TextBlock Text="{Binding VideoKindLabel}"/></StackPanel>
   </RadioButton>
   <RadioButton IsChecked="{Binding Audio}" IsEnabled="{Binding IsIdle}" GroupName="MediaKind" Style="{StaticResource FormatSegment}" Margin="5,0,0,0" AutomationProperties.Name="{Binding AudioKindLabel}">
    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource AudioIcon}" Style="{StaticResource LineIcon}" Margin="0,0,8,0"/><TextBlock Text="{Binding AudioKindLabel}"/></StackPanel>
   </RadioButton>
  </UniformGrid>
  <Grid Margin="0,0,0,10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="{Binding ContainerLabel}" Style="{StaticResource SectionLabel}"/>
    <Grid>
     <ComboBox ItemsSource="{Binding VideoContainers}" SelectedIndex="0" Visibility="{Binding Video,Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{Binding ContainerLabel}"/>
     <ComboBox ItemsSource="{Binding Encodings}" SelectedItem="{Binding SelectedEncoding}" DisplayMemberPath="Label" Visibility="{Binding Audio,Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{Binding AudioFormatLabel}"/>
    </Grid>
   </StackPanel>
   <StackPanel Grid.Column="2">
    <TextBlock Text="{Binding QualityLabel}" Style="{StaticResource SectionLabel}"/>
    <ComboBox x:Name="QualityInput" ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality}" DisplayMemberPath="Label" IsEnabled="{Binding CanChooseQuality}" AutomationProperties.Name="{Binding QualityLabel}"/>
   </StackPanel>
  </Grid>
  <Button Command="{Binding OptionsCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="0,10" Margin="0,0,0,14" AutomationProperties.Name="{Binding OptionsLabel}">
   <StackPanel Orientation="Horizontal"><Path Data="{StaticResource ChevronIcon}" Style="{StaticResource LineIcon}" Width="14" Margin="0,0,10,0"/>
    <StackPanel><TextBlock Text="{Binding OptionsLabel}" Foreground="{DynamicResource Ink}"/><TextBlock Text="{Binding OptionsHint}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
   </StackPanel>
  </Button>
  <Border x:Name="OutputOptions" Visibility="{Binding OptionsVisible,Converter={StaticResource BoolVisibility}}" Background="{DynamicResource Surface}" CornerRadius="8" Padding="16" Margin="0,0,0,22">
   <StackPanel IsEnabled="{Binding IsIdle}">
    <TextBlock Text="{Binding CaptionsLabel}" Style="{StaticResource SectionLabel}"/>
    <ComboBox ItemsSource="{Binding CaptionChoices}" SelectedItem="{Binding SelectedCaption}" AutomationProperties.Name="{Binding CaptionsLabel}"/>
    <WrapPanel Margin="0,10,0,0">
     <RadioButton Content="SRT" IsChecked="{Binding SrtCaptions}" GroupName="Captions" MinWidth="90" Margin="0,0,8,0"/>
     <RadioButton Content="VTT" IsChecked="{Binding VttCaptions}" GroupName="Captions" MinWidth="90"/>
    </WrapPanel>
    <Button Content="{Binding CaptionLanguagesLabel}" Command="{Binding CaptionLanguagesCommand}" Style="{StaticResource QuietButton}" Visibility="{Binding HasPlaylist,Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
    <TextBlock Text="{Binding OutputHint}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,12,0,0"/>
   </StackPanel>
  </Border>
  <TextBlock Text="{Binding FolderLabel}" Style="{StaticResource SectionLabel}"/>
  <Grid x:Name="FolderAnchor">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
   <Button x:Name="DestinationPicker" Command="{Binding BrowseCommand}" HorizontalContentAlignment="Left" ToolTip="{Binding Folder}" AutomationProperties.Name="{Binding FolderAccessibleName}" Padding="12,8">
    <DockPanel><Path Data="{StaticResource FolderIcon}" Style="{StaticResource LineIcon}" Margin="0,0,10,0"/><TextBlock Text="{Binding FolderDisplay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FlowDirection="LeftToRight"/></DockPanel>
   </Button>
   <Button Grid.Column="2" Content="{Binding ChangeFolderLabel}" Command="{Binding BrowseCommand}" MinWidth="78"/>
   <Button Grid.Column="4" Command="{Binding OpenFolderCommand}" AutomationProperties.Name="{Binding OpenFolderLabel}" ToolTip="{Binding OpenFolderLabel}" Padding="10"><Path Data="{StaticResource OpenFolderIcon}" Style="{StaticResource LineIcon}"/></Button>
  </Grid>
  <StackPanel x:Name="FolderNoticeHost" FlowDirection="LeftToRight"/>
  <Grid Margin="0,20,0,14">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button Command="{Binding AddQueueCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="0,6" AutomationProperties.Name="{Binding AddQueueLabel}">
    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource PlusIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Accent}" Margin="0,0,10,0"/><TextBlock Text="{Binding AddQueueLabel}" Foreground="{DynamicResource Ink}"/></StackPanel>
   </Button>
   <Button Grid.Column="1" Content="{Binding QueueLabel}" Command="{Binding QueueCommand}" Style="{StaticResource QuietButton}" FontSize="12" Padding="8,6"/>
  </Grid>
  <Button x:Name="DownloadButton" Command="{Binding DownloadCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding DownloadLabel}">
   <StackPanel Orientation="Horizontal"><Path Data="{StaticResource DownloadIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource OnAccent}" Margin="0,0,10,0"/><TextBlock Text="{Binding DownloadLabel}" Foreground="{DynamicResource OnAccent}" FontSize="17" FontWeight="SemiBold"/></StackPanel>
  </Button>
 </StackPanel>
</UserControl>
