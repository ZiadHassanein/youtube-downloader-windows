<UserControl x:Class="YouTubeDownloader.AppHeaderView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FlowDirection="LeftToRight" FontFamily="{Binding ContentFont}">
 <Border Background="{DynamicResource Page}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="24,16">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="BrandButton" Command="{Binding NewDownloadCommand}" Click="LogoClicked" Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left" Padding="0" AutomationProperties.Name="{Binding NewDownloadLabel}">
    <StackPanel Orientation="Horizontal">
     <Grid x:Name="BrandArtwork" Width="38" Height="42" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform><ScaleTransform x:Name="LogoScale"/></Grid.RenderTransform>
      <Path x:Name="BrandMark" Data="{StaticResource BrandMarkGeometry}" Fill="{StaticResource BrandFill}" Width="38" Height="42" Stretch="Uniform" AutomationProperties.Name="Vydrop logo"/>
      <Path x:Name="LogoLight" Data="{StaticResource BrandMarkGeometry}" Width="38" Height="42" Stretch="Uniform" IsHitTestVisible="False" Opacity="0">
       <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.4">
        <LinearGradientBrush.RelativeTransform><TranslateTransform x:Name="LightOffset" X="1.2"/></LinearGradientBrush.RelativeTransform>
        <GradientStop Color="#00FFFFFF" Offset="0.2"/><GradientStop Color="#CFFFFFFF" Offset="0.5"/><GradientStop Color="#00FFFFFF" Offset="0.8"/>
       </LinearGradientBrush></Path.Fill>
      </Path>
     </Grid>
     <Path x:Name="BrandWordmark" Data="{StaticResource BrandWordmarkGeometry}" Width="106" Height="32" Stretch="Uniform" Fill="{DynamicResource Ink}" VerticalAlignment="Center" FlowDirection="LeftToRight" AutomationProperties.Name="Vydrop"/>
    </StackPanel>
   </Button>
   <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button x:Name="RecentDownloadsButton" Command="{Binding HistoryCommand}" Style="{StaticResource ToolbarButton}" Padding="10,6" AutomationProperties.Name="{Binding HistoryAccessibleName}">
     <StackPanel Orientation="Horizontal" FlowDirection="{Binding ContentDirection}">
      <Path Data="{StaticResource HistoryIcon}" Style="{StaticResource LineIcon}" Width="20" Height="20" Margin="0,0,10,0"/>
      <TextBlock Text="{Binding HistoryLabel}" VerticalAlignment="Center" FontSize="13"/>
      <Border x:Name="RecentDownloadsBadge" Background="{DynamicResource Selected}" CornerRadius="10" MinWidth="20" Height="20" Padding="5,0" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasRecentDownloadsBadge,Converter={StaticResource BoolVisibility}}">
       <TextBlock Text="{Binding RecentDownloadsBadge}" Foreground="{DynamicResource Accent}" FontSize="11" FontFamily="{StaticResource LatinFont}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FlowDirection="LeftToRight" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding HistoryAccessibleName}"/>
      </Border>
     </StackPanel>
    </Button>
    <Border Width="1" Height="28" Background="{DynamicResource Divider}" Margin="12,0"/>
    <Button x:Name="LanguageButton" Click="LanguageClicked" PreviewKeyDown="LanguageKeyDown" ContextMenuOpening="LanguageMenuOpening" ContextMenuService.Placement="Custom" IsEnabled="{Binding IsIdle}" Style="{StaticResource ToolbarButton}" Padding="4,6" AutomationProperties.Name="{Binding LanguageLabel}" AutomationProperties.HelpText="{Binding CurrentLanguageLabel}" ToolTip="{Binding LanguageLabel}">
     <Button.ContextMenu>
      <ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}" FlowDirection="{Binding ContentDirection}" FontFamily="{Binding ContentFont}" FontSize="14" Width="160" StaysOpen="False" Placement="Custom">
       <ContextMenu.Template><ControlTemplate TargetType="ContextMenu">
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="8" Padding="4"><ItemsPresenter/></Border>
       </ControlTemplate></ContextMenu.Template>
       <MenuItem x:Name="EnglishChoice" Header="English" FontFamily="{StaticResource LatinFont}" Command="{Binding SelectLanguageCommand}" CommandParameter="en" IsChecked="{Binding IsEnglish,Mode=OneWay}" Style="{StaticResource LanguageMenuItem}"/>
       <MenuItem x:Name="ArabicChoice" Header="العربية" FontFamily="{StaticResource ArabicFont}" Command="{Binding SelectLanguageCommand}" CommandParameter="ar" IsChecked="{Binding IsArabic,Mode=OneWay}" Style="{StaticResource LanguageMenuItem}" Margin="0"/>
      </ContextMenu>
     </Button.ContextMenu>
     <StackPanel Orientation="Horizontal">
      <Path Data="{StaticResource GlobeIcon}" Style="{StaticResource LineIcon}" Width="20" Height="20" Margin="0,0,9,0"/>
      <TextBlock Text="{Binding CurrentLanguageLabel}" VerticalAlignment="Center" FontSize="14"/>
      <Path Data="{StaticResource ChevronIcon}" Style="{StaticResource LineIcon}" Width="10" Height="7" Margin="10,0,0,0"/>
     </StackPanel>
    </Button>
    <Border Width="1" Height="28" Background="{DynamicResource Divider}" Margin="12,0"/>
    <Button x:Name="ThemeButton" Command="{Binding ThemeCommand}" Style="{StaticResource ToolbarButton}" Width="42" Padding="9" AutomationProperties.Name="{Binding ThemeAction}" ToolTip="{Binding ThemeAction}">
     <Path Data="{Binding ThemeIcon}" Stroke="{DynamicResource Ink}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="22" Height="22"/>
    </Button>
   </StackPanel>
  </Grid>
 </Border>
</UserControl>
