<UserControl x:Class="YouTubeDownloader.AppFooterView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FlowDirection="LeftToRight">
 <UserControl.Resources>
  <Geometry x:Key="ContactRepositoryIcon">M6,7 A2,2 0 1 1 6,3 A2,2 0 1 1 6,7 M6,7 L6,15 M6,19 A2,2 0 1 1 6,15 A2,2 0 1 1 6,19 M16,7 A2,2 0 1 1 16,3 A2,2 0 1 1 16,7 M16,7 L16,9 Q16,12 13,12 L9,12 Q6,12 6,15</Geometry>
  <Geometry x:Key="ContactProfileIcon">M1,1 L19,1 19,19 1,19 Z M5,9 L5,15 M5,5 L5,5.2 M9,15 L9,9 M9,11 C9,8 15,8 15,11 L15,15</Geometry>
  <Geometry x:Key="ContactEmailIcon">M2,4 L18,4 18,16 2,16 Z M2,5 L10,11 18,5</Geometry>
  <Style x:Key="ContactTriggerStyle" TargetType="Button" BasedOn="{StaticResource QuietButton}">
   <Style.Triggers>
    <DataTrigger Binding="{Binding ContextMenu.IsOpen,RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Background" Value="{DynamicResource Selected}"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="ContactMenuItem" TargetType="MenuItem">
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="MinHeight" Value="40"/>
   <Setter Property="Margin" Value="0,0,0,4"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="MenuItem">
     <Grid>
      <Border x:Name="Face" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="7" Padding="12,7">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ContentPresenter x:Name="ContactIcon" ContentSource="Icon" FlowDirection="LeftToRight" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <ContentPresenter Grid.Column="2" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
       </Grid>
      </Border>
      <Border x:Name="FocusRing" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="7" Opacity="0" IsHitTestVisible="False"/>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Opacity" Value="1"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <Button x:Name="SettingsButton" Content="{Binding SettingsLabel}" Command="{Binding SettingsCommand}" FontFamily="{Binding ContentFont}" Style="{StaticResource QuietButton}" FontSize="12" Padding="7,4" MinHeight="28" HorizontalAlignment="Left" VerticalAlignment="Center"/>
  <Button x:Name="ContactButton" Grid.Column="1" Click="ContactClicked" PreviewKeyDown="ContactKeyDown"
          Style="{StaticResource ContactTriggerStyle}" FontFamily="{Binding ContentFont}" FontSize="12" Height="32" MinHeight="32" Padding="7,4" AutomationProperties.Name="{Binding ContactLabel}" ContextMenuService.Placement="Custom">
   <Button.ContextMenu>
    <ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}" FlowDirection="{Binding ContentDirection}"
                 FontFamily="{Binding ContentFont}" FontSize="14" Width="208" TextBlock.LineHeight="22" TextBlock.LineStackingStrategy="BlockLineHeight" Placement="Custom">
     <ContextMenu.Template><ControlTemplate TargetType="ContextMenu">
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="8" Padding="4"><ItemsPresenter/></Border>
     </ControlTemplate></ContextMenu.Template>
     <MenuItem x:Name="GitHubContact" Header="GitHub" Command="{Binding SocialCommand}" CommandParameter="github" Style="{StaticResource ContactMenuItem}"><MenuItem.Icon><Path Data="{StaticResource ContactRepositoryIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Accent}" Width="17" Height="18"/></MenuItem.Icon></MenuItem>
     <MenuItem x:Name="LinkedInContact" Header="LinkedIn" Command="{Binding SocialCommand}" CommandParameter="linkedin" Style="{StaticResource ContactMenuItem}"><MenuItem.Icon><Path Data="{StaticResource ContactProfileIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Accent}" Width="17" Height="18"/></MenuItem.Icon></MenuItem>
     <MenuItem x:Name="EmailContact" Header="{Binding EmailLabel}" Command="{Binding SocialCommand}" CommandParameter="email" Style="{StaticResource ContactMenuItem}" Margin="0"><MenuItem.Icon><Path Data="{StaticResource ContactEmailIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Accent}" Width="17" Height="18"/></MenuItem.Icon></MenuItem>
    </ContextMenu>
   </Button.ContextMenu>
   <StackPanel Orientation="Horizontal" FlowDirection="{Binding ContentDirection}">
    <TextBlock Text="{Binding ContactLabel}" VerticalAlignment="Center"/>
    <Path Data="{StaticResource ChevronIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Accent}" Width="9" Height="6" Margin="8,0,0,0" RenderTransformOrigin="0.5,0.5">
     <Path.RenderTransform><RotateTransform Angle="180"/></Path.RenderTransform>
    </Path>
   </StackPanel>
  </Button>
 </Grid>
</UserControl>
