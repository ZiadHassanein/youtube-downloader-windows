<Window x:Class="YouTubeDownloader.RecentDownloadsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{Binding Heading}" Width="600" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 AutomationProperties.IsDialog="True" Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}"
 FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <Style x:Key="HistoryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="10,5"/>
  </Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8,10"/>
   <Setter Property="Margin" Value="0,0,0,4"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="ListBoxItem">
     <Border x:Name="Face" Background="Transparent" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
      <ContentPresenter/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource Surface}"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid x:Name="HistoryContent" Margin="24,20" TextBlock.LineHeight="20" TextBlock.LineStackingStrategy="BlockLineHeight" KeyboardNavigation.TabNavigation="Cycle">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16">
   <TextBlock Text="{Binding Heading}" FontSize="21" FontWeight="SemiBold" LineHeight="30"/>
   <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
  </StackPanel>
  <ListBox x:Name="HistoryList" Grid.Row="1" ItemsSource="{Binding Files}" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Ink}" MinHeight="120" MaxHeight="320"
           HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False"
           AutomationProperties.Name="{Binding Heading}">
   <ListBox.Resources><Style TargetType="ScrollViewer" BasedOn="{StaticResource InsetScrollFrame}"/></ListBox.Resources>
   <ListBox.ItemTemplate><DataTemplate>
    <Grid ToolTip="{Binding FilePath}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Path Width="24" Height="24" Stretch="Uniform" Stroke="{DynamicResource Accent}" StrokeThickness="1.5" VerticalAlignment="Top" Margin="0,3,0,0">
      <Path.Style><Style TargetType="Path"><Setter Property="Data" Value="{DynamicResource VideoIcon}"/><Style.Triggers><DataTrigger Binding="{Binding IsAudio}" Value="True"><Setter Property="Data" Value="{DynamicResource AudioIcon}"/></DataTrigger></Style.Triggers></Style></Path.Style>
     </Path>
     <StackPanel Grid.Column="2">
      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" LineHeight="22" Height="22" MaxHeight="22"/>
      <TextBlock Text="{Binding Details}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,5,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding Folder}" Foreground="{DynamicResource Muted}" FontSize="11" LineHeight="16" Margin="0,3,0,0" FlowDirection="LeftToRight" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
     <Button Grid.Column="4" Style="{StaticResource HistoryButton}" VerticalAlignment="Center"
             Content="{Binding DataContext.RevealLabel,RelativeSource={RelativeSource AncestorType=Window}}"
             Command="{Binding DataContext.RevealCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
             AutomationProperties.HelpText="{Binding FilePath}"/>
    </Grid>
   </DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <StackPanel x:Name="HistoryEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Visibility="{Binding IsEmpty,Converter={StaticResource BoolVisibility}}">
   <Path Data="{DynamicResource HistoryIcon}" Style="{DynamicResource LineIcon}" Width="30" Height="30" Stroke="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
   <TextBlock Text="{Binding EmptyHeading}" FontWeight="SemiBold" FontSize="16" TextAlignment="Center"/>
   <TextBlock Text="{Binding EmptyDetail}" Foreground="{DynamicResource Muted}" TextAlignment="Center" Margin="0,6,0,0"/>
  </StackPanel>
  <TextBlock x:Name="HistoryError" Grid.Row="2" Text="{Binding Error}" Foreground="{DynamicResource Error}" MinHeight="20" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
  <Border Grid.Row="3" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
   <Button x:Name="HistoryClose" Content="{Binding CloseLabel}" Style="{StaticResource HistoryButton}" IsCancel="True" MinWidth="80" HorizontalAlignment="Right"/>
  </Border>
 </Grid>
</Window>
