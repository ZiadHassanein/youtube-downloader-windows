# Normalize text files to LF in the repository; the working tree follows core.autocrlf and .editorconfig.
* text=auto

# Windows-only scripts keep CRLF on checkout everywhere.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf

# Binary assets are never normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.otf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.zip binary
*.exe binary
*.dll binary
